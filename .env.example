# Copy to .env.local for local development.
DATABASE_URL="postgresql://mandovara:mandovara@localhost:55432/mandovara?schema=public"
REDIS_URL="redis://localhost:56379"

# REQUIRED. Signs session cookies (HMAC-SHA256). Must be 32+ characters.
# Generate: `openssl rand -hex 32` (produces 64 hex chars).
# Rotating this invalidates every active session — do it if it leaks.
SESSION_SECRET=""
