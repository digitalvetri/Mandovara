  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorId, createdAt])
}

model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  role           AppRole?
  roleId         String?
  tableKey       String
  name           String
  config         Json
}

model Setting {
  id             String @id @default(cuid())
  organizationId String
  key            String
  value          Json

  @@unique([organizationId, key])
}
