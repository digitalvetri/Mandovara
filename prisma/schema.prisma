generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

// Legacy — kept during RBAC migration; removed once User.roleId fully backfilled
enum AppRole {
  OWNER
  DESIGNER
  SALES
  MEASURE_EXEC
  STORE
  MAKE_SUPERVISOR
  INSTALLER
  ACCOUNTS
  HR
}

// Dynamic permission scope (Phase 1 — RBAC overhaul)
enum PermScope {
  NONE
  VIEW
  OWN
  FULL
}

enum UserStatus {
