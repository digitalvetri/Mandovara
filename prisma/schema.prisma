  month          Int
  year           Int
  status         PayrollStatus @default(DRAFT)
  approvedById   String?
  approvedAt     DateTime?
  paidAt         DateTime?

  payslips Payslip[]

  @@unique([organizationId, month, year])
}

model Payslip {
  id             String     @id @default(cuid())
  organizationId String
  payrollRunId   String
  employeeId     String
  daysPresent    Decimal    @db.Decimal(4, 1)
  lopDays        Decimal    @db.Decimal(4, 1)
  otHours        Decimal    @db.Decimal(6, 2) @default(0)
  earnings       Json
  deductions     Json
  reimbursements BigInt     @default(0)
  netPay         BigInt
  pdfKey         String?

  run PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@unique([payrollRunId, employeeId])
}

// ─── COLLABORATION ───────────────────────────────────────────────────────────

model Task {
  id             String       @id @default(cuid())
  organizationId String
  number         String
  title          String
  description    String?
  projectId      String?
  refType        String?
  refId          String?
  assignedToId   String
  createdById    String
  dueAt          DateTime?
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(TODO)
  completedAt    DateTime?

  comments TaskComment[]

  @@unique([organizationId, number])
  @@index([organizationId, assignedToId, status])
}

model TaskComment {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  authorId       String
  body           String
  fileKeys       String[]
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ChatChannel {
  id             String      @id @default(cuid())
  organizationId String
  kind           ChannelKind
  name           String?
  projectId      String?
  departmentId   String?
  createdById    String
  createdAt      DateTime    @default(now())

  members  ChatMember[]
  messages ChatMessage[]

  @@index([organizationId, kind])
}

model ChatMember {
  id             String    @id @default(cuid())
  organizationId String
  channelId      String
  userId         String
  lastReadAt     DateTime?
  isMuted        Boolean   @default(false)

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model ChatMessage {
  id             String    @id @default(cuid())
  organizationId String
  channelId      String
  authorId       String
  body           String?
  fileKeys       String[]
  replyToId      String?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model CalendarEvent {
  id               String    @id @default(cuid())
  organizationId   String
  kind             EventKind
  title            String
  refType          String?
  refId            String?
  startAt          DateTime
  endAt            DateTime?
  allDay           Boolean   @default(false)
  attendeeUserIds  String[]
  location         String?

  @@index([organizationId, startAt])
}

// Unified document model — ownerType: PROJECT LEAD CLIENT MEASUREMENT QUOTATION INSTALL EMPLOYEE
model Document {
  id             String   @id @default(cuid())
  organizationId String
  ownerType      String
  ownerId        String
  projectId      String?
  leadId         String?
  category       String
  fileKey        String
  fileName       String
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  createdAt      DateTime @default(now())

  @@index([organizationId, ownerType, ownerId])
}

model Notification {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String
  refType        String?
  refId          String?
  channels       NotifyChannel[]
  readAt         DateTime?
  createdAt      DateTime       @default(now())

  @@index([organizationId, userId, readAt])
}

// Unified comms log — covers both WhatsApp and Email, IN and OUT
model CommunicationLog {
  id               String         @id @default(cuid())
  organizationId   String
  idempotencyKey   String         @unique
  channel          NotifyChannel
  templateId       String?
  category         MsgCategory?
  toMobile         String?
  toEmail          String?
  clientId         String?
  leadId           String?
  projectId        String?
  direction        String         @default("OUT")
  body             String?
  status           MsgStatus      @default(QUEUED)
  providerMessageId String?
  costPaise        BigInt         @default(0)
  error            String?
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, clientId])
}

// ─── AUTOMATION & PLATFORM ───────────────────────────────────────────────────

model MessageTemplate {
  id               String        @id @default(cuid())
  organizationId   String
  channel          NotifyChannel @default(WHATSAPP)
  name             String
  metaTemplateName String?
  category         MsgCategory   @default(UTILITY)
  language         String        @default("en")
  subject          String?
  bodyText         String
  variables        String[]
  metaStatus       String        @default("DRAFT")

  @@unique([organizationId, name, language])
}

// Kept for backward compat alongside CommunicationLog
model AutomationLog {
  id             String      @id @default(cuid())
  organizationId String
  idempotencyKey String      @unique
  templateId     String?
  category       MsgCategory
  toMobile       String
  refType        String?
  refId          String?
  status         MsgStatus   @default(QUEUED)
  metaMessageId  String?
  costPaise      BigInt      @default(0)
  error          String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  @@index([organizationId, createdAt])
}

model WhatsAppConversation {
  id                     String    @id @default(cuid())
  organizationId         String
  mobile                 String
  clientId               String?
  leadId                 String?
  projectId              String?
  serviceWindowExpiresAt DateTime?
  assignedToId           String?
  lastMessageAt          DateTime

  @@unique([organizationId, mobile])
}

model AutomationRule {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  triggerEvent   String
  conditions     Json
  actions        Json
  isActive       Boolean @default(true)
}

model FollowUp {
  id             String    @id @default(cuid())
  organizationId String
  refType        String
  refId          String
  ownerId        String
  dueAt          DateTime
  note           String
  outcome        String?
  nextActionAt   DateTime?
  completedAt    DateTime?
  escalatedAt    DateTime?

  @@index([organizationId, ownerId, dueAt])
}

// Kept alongside Document model for backward compat
model ProjectDocument {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  type           String
  fileKey        String
  fileName       String
  uploadedById   String
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

// ─── PLATFORM ────────────────────────────────────────────────────────────────

model NumberSequence {
  id             String @id @default(cuid())
  organizationId String
  series         String
  yymm           String
  counter        Int    @default(0)

  @@unique([organizationId, series, yymm])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String
  entityType     String
  entityId       String
  action         String
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorId, createdAt])
}

model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  role           AppRole?
  roleId         String?
  tableKey       String
  name           String
  config         Json
}

model Setting {
  id             String @id @default(cuid())
  organizationId String
  key            String
  value          Json

  @@unique([organizationId, key])
}
