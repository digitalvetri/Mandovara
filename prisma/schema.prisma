  unit              SellUnit
  rate              BigInt
  discountPct       Decimal  @db.Decimal(5, 2) @default(0)
  taxable           BigInt
  gstRate           Decimal  @db.Decimal(5, 2)
  cgst              BigInt
  sgst              BigInt
  igst              BigInt
  amount            BigInt
  isOptional        Boolean  @default(false)
  calcSnapshot      Json?

  quotation Quotation        @relation(fields: [quotationId], references: [id])
