// Mandovara Business OS — full data model.
// Source of truth: docs/BUILD-SPEC.md §9. Conventions in §9.1:
//   - id String @id @default(cuid())
//   - createdAt / updatedAt on every model
//   - createdById / updatedById as opaque strings (no back-relation on User)
//   - orgId on every tenant-scoped model + @@index([orgId])
//   - branchId on every branch-scoped model
//   - money: BigInt paise. quantity: Decimal(18,4)
//   - soft delete via status enum, never a `deleted` boolean

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

