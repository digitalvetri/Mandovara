// ─── ORG, ROLES & PEOPLE ────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(cuid())
  name          String
  legalName     String?
  gstin         String?
  pan           String?
  addressLine   String?
  city          String?  @default("Coimbatore")
  state         String?  @default("Tamil Nadu")
  stateCode     String   @default("33")
  pincode       String?  @default("641002")
  phone         String?
  email         String?
  website       String?
  logoKey       String?
  letterheadKey String?
  fyStartMonth  Int      @default(4)
  settings      Json
  createdAt     DateTime @default(now())

  branches    Branch[]
  users       User[]
  roles       Role[]
  departments Department[]
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  gstin          String?
  stateCode      String       @default("33")
  address        Json?
  invoicePrefix  String       @default("MDV")

  org            Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ─── RBAC: dynamic role matrix ───────────────────────────────────────────────

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  headEmployeeId String?

  org            Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isOwnerRole    Boolean  @default(false)
  isSystem       Boolean  @default(false)

  permissions    RolePermission[]
  users          User[]

  org            Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model RolePermission {
  id     String    @id @default(cuid())
  roleId String
  key    String
  scope  PermScope @default(NONE)

  role   Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, key])
}

// ─── USERS & EMPLOYEES ───────────────────────────────────────────────────────

model User {
  id                 String     @id @default(cuid())
  organizationId     String
  mobile             String
  email              String?
  name               String
  passwordHash       String?
  role               AppRole                     // legacy — kept until RBAC migration complete
  roleId             String?                     // new dynamic role (nullable during transition)
  branchIds          String[]
  locale             String     @default("en")
  status             UserStatus @default(ACTIVE)
  avatarKey          String?
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  notifyPrefs        Json?
  departmentId       String?
  createdAt          DateTime   @default(now())

  org         Organization @relation(fields: [organizationId], references: [id])
  dynamicRole Role?        @relation(fields: [roleId], references: [id])

  @@unique([organizationId, mobile])
}

model Employee {
  id               String     @id @default(cuid())
  organizationId   String
  userId           String?    @unique
  code             String
  name             String
  mobile           String
  designation      String
  department       String
  departmentId     String?
  reportsToId      String?
  doj              DateTime
  dob              DateTime?
  emergencyContact Json?
  bankDetails      Json?
  salaryStructure  Json?
  wageType         String     @default("MONTHLY")
  status           UserStatus @default(ACTIVE)

  @@unique([organizationId, code])
}

// ─── CATALOG: Brand → Collection → Design → Colourway ───────────────────────

model Brand {
  id           String       @id @default(cuid())
  organizationId String
  name         String
  country      String?
  leadTimeDays Int          @default(14)
  vendorId     String?
  logoKey      String?
  isActive     Boolean      @default(true)

  collections  Collection[]

  @@unique([organizationId, name])
}

model Collection {
  id             String        @id @default(cuid())
  organizationId String
  brandId        String
  name           String
  family         ProductFamily
  seasonYear     Int?
  catalogPdfKey  String?
  isActive       Boolean       @default(true)

  brand       Brand        @relation(fields: [brandId], references: [id])
  designs     Design[]
  sampleBooks SampleBook[]

  @@unique([organizationId, brandId, name])
  @@index([organizationId, family])
}

model Design {
  id              String        @id @default(cuid())
  organizationId  String
  collectionId    String
  code            String
  name            String
  family          ProductFamily
  rollWidthMm     Decimal?      @db.Decimal(10, 2)
  rollLengthM     Decimal?      @db.Decimal(10, 3)
  fabricWidthMm   Decimal?      @db.Decimal(10, 2)
  patternRepeatMm Decimal?      @db.Decimal(10, 2)
  patternMatch    PatternMatch  @default(FREE)
  railroadable    Boolean       @default(false)
  gsm             Int?
  thicknessMm     Decimal?      @db.Decimal(6, 2)
  areaPerBoxSqft  Decimal?      @db.Decimal(10, 3)
  tileSizeMm      String?
  // Full supplier catalogue PDF for this design's series. Rendered
  // in the PDP as a browser-native flip-through viewer so the user
  // can page through every pattern before quoting.
  catalogPdfKey   String?
  specs           Json
  hsn             String
  gstRate         Decimal       @db.Decimal(5, 2)
  isActive        Boolean       @default(true)
  searchVector    Unsupported("tsvector")?

  collection Collection  @relation(fields: [collectionId], references: [id])
  colourways Colourway[]

  @@unique([organizationId, collectionId, code])
  @@index([organizationId, family])
}

model Colourway {
  id             String    @id @default(cuid())
  organizationId String
  designId       String
  code           String
  colourName     String
  hex            String?
  imageKey       String?
  sellUnit       SellUnit
  moq            Decimal?  @db.Decimal(10, 3)
  reorderLevel   Decimal?  @db.Decimal(10, 3)
  isActive       Boolean   @default(true)

  design     Design       @relation(fields: [designId], references: [id])
  prices     Price[]
  stock      StockBalance[]
  orderLines OrderLine[]  @relation("OrderLineColourway")

  @@unique([organizationId, code])
  @@index([organizationId, designId])
}

model Price {
  id            String    @id @default(cuid())
  organizationId String
  colourwayId   String
  tier          String
  clientId      String?
  amount        BigInt
  minChargeSqft Decimal?  @db.Decimal(10, 3)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  colourway Colourway @relation(fields: [colourwayId], references: [id])

  @@index([colourwayId, tier, effectiveFrom])
}

model ServiceRate {
  id             String        @id @default(cuid())
  organizationId String
  family         ProductFamily
  code           String
  name           String
  unit           SellUnit
  amount         BigInt
  effectiveFrom  DateTime

  @@unique([organizationId, code, effectiveFrom])
}

// ─── SAMPLE LIBRARY ──────────────────────────────────────────────────────────

model SampleBook {
  id             String       @id @default(cuid())
  organizationId String
  collectionId   String
  barcode        String
  costValue      BigInt
  status         SampleStatus @default(IN_LIBRARY)

  collection Collection    @relation(fields: [collectionId], references: [id])
  issues     SampleIssue[]

  @@unique([organizationId, barcode])
}

model SampleIssue {
  id             String    @id @default(cuid())
  organizationId String
  sampleBookId   String
  issuedToType   String
  clientId       String?
  architectId    String?
  userId         String?
  issuedAt       DateTime  @default(now())
  dueAt          DateTime
  returnedAt     DateTime?
  depositAmount  BigInt    @default(0)
  notes          String?

  book SampleBook @relation(fields: [sampleBookId], references: [id])

  @@index([organizationId, dueAt])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Lead {
  id                String          @id @default(cuid())
  organizationId    String
  number            String
  name              String
  mobile            String
  email             String?
  source            LeadSource
  architectId       String?
  stage             LeadStage       @default(NEW)
  siteAddress       Json?
  requirement       String?
  familiesInterested ProductFamily[]
  budgetMin         BigInt?
  budgetMax         BigInt?
  score             Int?
  ownerId           String
  lostReason        String?
  nextActionAt      DateTime?
  convertedClientId String?
  createdAt         DateTime        @default(now())

  @@unique([organizationId, number])
  @@index([organizationId, stage, ownerId])
  @@index([organizationId, mobile])
}

model Client {
  id             String     @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           ClientType @default(HOMEOWNER)
  gstin          String?
  pan            String?
  mobile         String
  altMobile      String?
  email          String?
  billingAddress   Json
  stateCode        String  @default("33")
  priceTier        String  @default("RETAIL")
  creditLimit      BigInt  @default(0)
  paymentTermsDays Int     @default(30)
  architectId      String?
  ownerId        String?
  notes          String?
  createdAt      DateTime   @default(now())

  contacts ContactPerson[]
  projects Project[]

  @@unique([organizationId, code])
  @@index([organizationId, mobile])
}

model ContactPerson {
  id             String  @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  designation    String?
  mobile         String
  email          String?
  whatsappOptIn  Boolean @default(true)

  client Client @relation(fields: [clientId], references: [id])
}

model Architect {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  firmName       String
  contactName    String
  mobile         String
  email          String?
  commissionPct  Decimal @db.Decimal(5, 2) @default(0)
  address        Json?
  isActive       Boolean @default(true)

  commissions ArchitectCommission[]

  @@unique([organizationId, code])
}

model ArchitectCommission {
  id             String    @id @default(cuid())
  organizationId String
  architectId    String
  projectId      String
  baseAmount     BigInt
  pct            Decimal   @db.Decimal(5, 2)
  amount         BigInt
  paidAt         DateTime?
  paymentRef     String?

  architect Architect @relation(fields: [architectId], references: [id])

  @@index([organizationId, architectId, paidAt])
}

// ─── PROJECT · ROOM · SITE VISIT · MEASUREMENT ──────────────────────────────

model Project {
  id                String       @id @default(cuid())
  organizationId    String
  branchId          String
  number            String
  name              String
  clientId          String
  architectId       String?
  stage             ProjectStage @default(ENQUIRY)
  siteAddress       Json
  siteContactName   String?
  siteContactMobile String?
  expectedInstallAt DateTime?
  ownerId           String
  orderValue        BigInt       @default(0)
  createdAt         DateTime     @default(now())

  client       Client           @relation(fields: [clientId], references: [id])
  members      ProjectMember[]
  rooms        Room[]
  milestones   Milestone[]
  siteLogs     SiteLog[]
  siteVisits   SiteVisit[]
  measurements Measurement[]
  quotations   Quotation[]
  orders       Order[]
  installVisits InstallVisit[]
  expenses     ProjectExpense[]
  snags        Snag[]
  documents    ProjectDocument[]

  @@unique([organizationId, number])
  @@index([organizationId, stage])
  @@index([organizationId, clientId])
}

model Milestone {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  plannedDate    DateTime
  actualDate     DateTime?
  billingPct     Decimal  @db.Decimal(5, 2) @default(0)
  order          Int      @default(0)
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  // Milestone-template linkage (auto-generation from product families).
  // A milestone with templateCode is derived from a MilestoneTemplate row
  // for the project's set of families; a null templateCode means a
  // manually-added milestone. billingWeightPct is the normalised weight
  // after merging templates across families (sums to 100 across the set).
  templateCode     String?
  family           ProductFamily?
  billingWeightPct Decimal?      @db.Decimal(5, 2)
  autoCompleted    Boolean       @default(false)
  sourceEvent      String?
  plannedAt        DateTime?
  completedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([projectId, templateCode])
}

// Milestone templates seed the project milestone list from the project's
// product families. Common templates (family = null) apply to every
// project; family-specific templates merge in when that family is present.
// Weights normalise to 100% across the merged set at generation time.
model MilestoneTemplate {
  id               String        @id @default(cuid())
  organizationId   String
  family           ProductFamily?
  sequence         Int
  code             String
  name             String
  billingWeightPct Decimal       @db.Decimal(5, 2)
  autoCompleteOn   String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())

  @@unique([organizationId, family, code])
  @@index([organizationId, family, sequence])
}

model SiteLog {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  loggedAt       DateTime
  summary        String
  weather        String?
  manpowerCount  Int?
  createdById    String
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model ProjectMember {
  id             String  @id @default(cuid())
  organizationId String
  projectId      String
  userId         String
  roleOnProject  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Room {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  floorLabel     String?
  sortOrder      Int      @default(0)

  project Project           @relation(fields: [projectId], references: [id])
  items   MeasurementItem[]

  @@index([projectId])
}

model SiteVisit {
  id                String      @id @default(cuid())
  organizationId    String
  number            String
  projectId         String?
  leadId            String?
  purpose           VisitPurpose
  scheduledAt       DateTime
  assignedToId      String
  status            VisitStatus @default(SCHEDULED)
  startedAt         DateTime?
  completedAt       DateTime?
  checkInLat        Decimal?    @db.Decimal(10, 7)
  checkInLng        Decimal?    @db.Decimal(10, 7)
  observations      String?
  customerNotes     String?
  photoKeys         String[]
  rescheduleReason  String?
  reportPdfKey      String?

  project Project? @relation(fields: [projectId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, assignedToId, scheduledAt])
}

model Measurement {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  number         String
  siteVisitId    String?
  revision       Int               @default(0)
  visitedAt      DateTime
  measuredById   String
  status         MeasurementStatus @default(DRAFT)
  approvedById   String?
  approvedAt     DateTime?
  supersedesId   String?
  notes          String?

  project Project           @relation(fields: [projectId], references: [id])
  items   MeasurementItem[]

  @@unique([organizationId, number])
  @@index([projectId, status])
}

model MeasurementItem {
  id                 String        @id @default(cuid())
  organizationId     String
  measurementId      String
  roomId             String
  label              String
  surface            SurfaceType
  openingType        OpeningType?
  widthMm            Decimal       @db.Decimal(10, 2)
  heightMm           Decimal       @db.Decimal(10, 2)
  depthMm            Decimal?      @db.Decimal(10, 2)
  quantity           Int           @default(1)
  deductions         Json?
  family             ProductFamily
  headingType        HeadingType?
  fullness           Decimal?      @db.Decimal(4, 2)
  layPattern         LayPattern?
  mountType          MountType?
  trackTypeNote      String?
  requiresPowerPoint Boolean       @default(false)
  floorLevelDiffMm   Decimal?      @db.Decimal(10, 2)
  photoKeys          String[]
  sketchKey          String?
  notes              String?

  measurement Measurement      @relation(fields: [measurementId], references: [id])
  room        Room             @relation(fields: [roomId], references: [id])
  calc        CalcResult?
  quotationLines QuotationLine[]

  @@index([measurementId, roomId])
}

model CalcResult {
  id                String     @id @default(cuid())
  organizationId    String
  measurementItemId String     @unique
  colourwayId       String?
  engineVersion     String
  inputs            Json
  materialQty       Decimal    @db.Decimal(12, 3)
  materialUnit      SellUnit
  widthsRequired    Int?
  cutLengthMm       Decimal?   @db.Decimal(10, 2)
  rollsRequired     Int?
  boxesRequired     Int?
  areaSqft          Decimal?   @db.Decimal(12, 3)
  billableAreaSqft  Decimal?   @db.Decimal(12, 3)
  wastagePct        Decimal?   @db.Decimal(5, 2)
  fabricRun         FabricRun?
  seamCount         Int?
  liningQty         Decimal?   @db.Decimal(12, 3)
  adhesiveQty       Decimal?   @db.Decimal(12, 3)
  warnings          String[]
  computedAt        DateTime   @default(now())

  item MeasurementItem @relation(fields: [measurementItemId], references: [id])
}

// ─── QUOTATION ────────────────────────────────────────────────────────────────

model Quotation {
  id             String          @id @default(cuid())
  organizationId String
  branchId       String
  number         String
  revision       Int             @default(0)
  parentId       String?
  // FIXES-01 §5.1 — a quotation belongs to EITHER a lead (before
  // conversion) or a client (post-conversion), never both. XOR
  // enforced at the DB level via a CHECK constraint added in the
  // accompanying migration. projectId is only set once a client
  // exists, so it is nullable too.
  leadId         String?
  clientId       String?
  projectId      String?
  date           DateTime
  validUntil     DateTime
  status         QuotationStatus @default(DRAFT)
  taxableAmount  BigInt          @default(0)
  cgst           BigInt          @default(0)
  sgst           BigInt          @default(0)
  igst           BigInt          @default(0)
  roundOff       BigInt          @default(0)
  total          BigInt          @default(0)
  discountPct    Decimal         @db.Decimal(5, 2) @default(0)
  termsText      String?
  ownerId        String
  submittedById  String?
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectionReason String?
  sentAt         DateTime?
  pdfKey         String?

  project Project?        @relation(fields: [projectId], references: [id])
