model Quotation {
  id             String          @id @default(cuid())
  organizationId String
  branchId       String
  number         String
  revision       Int             @default(0)
  parentId       String?
  // FIXES-01 §5.1 — a quotation belongs to EITHER a lead (before
  // conversion) or a client (post-conversion), never both. XOR
  // enforced at the DB level via a CHECK constraint added in the
  // accompanying migration. projectId is only set once a client
  // exists, so it is nullable too.
  leadId         String?
  clientId       String?
  projectId      String?
  date           DateTime
  validUntil     DateTime
  status         QuotationStatus @default(DRAFT)
  taxableAmount  BigInt          @default(0)
  cgst           BigInt          @default(0)
  sgst           BigInt          @default(0)
  igst           BigInt          @default(0)
  roundOff       BigInt          @default(0)
  total          BigInt          @default(0)
  discountPct    Decimal         @db.Decimal(5, 2) @default(0)
  termsText      String?
  ownerId        String
  submittedById  String?
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectionReason String?
  sentAt              DateTime?
  pdfKey              String?
  shareToken          String?   @unique
  shareTokenExpiresAt DateTime?
  // Owner sign-off to CONVERT a lead-scoped quotation into a Client +
  // Project (FIXES-01 §5.1). Independent of `approvedById` (which is
  // internal quote approval before send). Both must be present + the
  // quote must be ACCEPTED before the lead can flip to WON.
  ownerConvertApprovedById String?
  ownerConvertApprovedAt   DateTime?

  project Project?        @relation(fields: [projectId], references: [id])
  lines   QuotationLine[]

  @@unique([organizationId, number, revision])
  @@index([organizationId, projectId, status])
  @@index([organizationId, leadId])
  @@index([organizationId, clientId])
}

model QuotationLine {
  id                String   @id @default(cuid())
