model Expense {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  head           String
  subHead        String?
  description    String
  amount         BigInt
  billKey        String?
  incurredAt     DateTime
  approvalState  ApprovalState @default(PENDING)
  // Null while the bill is still outstanding. Set when it clears. The "To Pay"
  // KPI counts approvalState=APPROVED AND paidAt IS NULL.
  paidAt         DateTime?
  // Set when this Expense was auto-created by a Purchase Order reaching
  // RECEIVED status. Enforced unique so a second GRN on the same PO can't
  // spawn a duplicate expense. No FK — POs can be archived without touching
  // the ledger row.
  sourcePoId     String?       @unique
  // GST input credit fields — captured at entry so the monthly filing
  // shows net liability (output − input). Null for exempt/unregistered bills.
  gstRatePct     Decimal?      @db.Decimal(5,2)   // 5 | 12 | 18 | 28
  taxable        BigInt?                            // amount excl. GST (paise)
  cgst           BigInt?
  sgst           BigInt?
  igst           BigInt?                            // inter-state purchase
  vendorGstin    String?
  billRef        String?                            // vendor's invoice number

  @@index([organizationId, incurredAt])
  @@index([organizationId, approvalState, paidAt])
}

