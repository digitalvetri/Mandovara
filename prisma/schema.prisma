// PLATFORM — saved views, settings, imports, exports
// =================================================================

model SavedView {
  id         String   @id @default(cuid())
  orgId      String
  ownerId    String?                              // null = shared with role
  roleId     String?
  entityType String                               // "product" | "invoice" | ...
  name       String
  filters    Json
  columns    Json
  sort       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId, entityType])
}

model Setting {
  id        String @id @default(cuid())
  orgId     String
  key       String
  value     Json

  @@unique([orgId, key])
}

model ImportJob {
  id           String        @id @default(cuid())
  orgId        String
  branchId     String?
  entityType   String
  fileKey      String
  totalRows    Int           @default(0)
  successRows  Int           @default(0)
  failedRows   Int           @default(0)
  errorFileKey String?
  status       ImportStatus  @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime      @default(now())
  createdById  String?

  @@index([orgId, status])
}

model ExportJob {
  id          String        @id @default(cuid())
  orgId       String
  entityType  String
  filters     Json
  fileKey     String?
  status      ImportStatus  @default(PENDING)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime      @default(now())
  createdById String?

  @@index([orgId, status])
}
